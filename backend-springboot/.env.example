# Optional backend-local overrides. Keep the existing root .env DB_PASSWORD.
# If copying this file to backend-springboot/.env, fill DB_PASSWORD with the
# existing database password: a blank override will replace the root value.
DB_URL=jdbc:postgresql://localhost:5433/smartroom_iot
DB_USERNAME=smartroom
DB_PASSWORD=

# Local profile. Cloud: supply the actual ssl://hostname:8883 and enable TLS.
# No cloud hostname or credential has been supplied yet.
MQTT_BROKER_URL=tcp://192.168.130.174:1883
MQTT_CLIENT_ID=smartroom-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false
# Empty uses the JVM trust store; optional absolute file path or file: URI.
MQTT_CA_PATH=

CORS_ORIGIN=http://localhost:5173
